	(text "Clock switching, break-before-make: \n  MUTE high → \n  stop I2S → \n  disable the old oscillator (IO47 or IO48 low) → \n  wait ≥ 1 ms → enable the new oscillator →\n  wait ≥ 15 ms → reconfigure I2S (external clock source, new rate) → start →\n  wait 1 ms → MUTE low. \n    Never have IO47 and IO48 high at the same time."
		(exclude_from_sim no)
		(at 82.804 180.34 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left)
		)
		(uuid "f85a9fa4-e39b-44a6-96fc-136f9b483c40")
	)
